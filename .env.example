# =======================================================
# SmartBill Backend — Production & Local Environment Variables
# =======================================================

# Port provided automatically by Render in production (defaults to 8080 locally)
PORT=8080

# =======================================================
# Neon PostgreSQL Database Configuration
# =======================================================
# Note: Always use the JDBC connection string with ?sslmode=require
DATABASE_URL=jdbc:postgresql://<your-neon-endpoint>.neon.tech/<dbname>?sslmode=require
DATABASE_USERNAME=<your-neon-username>
DATABASE_PASSWORD=<your-neon-password>

# Alternative Spring standard environment variable names:
# SPRING_DATASOURCE_URL=jdbc:postgresql://<your-neon-endpoint>.neon.tech/<dbname>?sslmode=require
# SPRING_DATASOURCE_USERNAME=<your-neon-username>
# SPRING_DATASOURCE_PASSWORD=<your-neon-password>

# =======================================================
# JWT Security Configuration
# =======================================================
# 256-bit Base64-encoded secret key for signing JWT tokens
JWT_SECRET=your_production_jwt_secret_key_minimum_256_bits_length_here_1234567890
# Token expiration in milliseconds (86400000 = 24 hours)
JWT_EXPIRATION=86400000

# =======================================================
# Frontend CORS Configuration
# =======================================================
# URL of your deployed frontend (e.g., Vercel, Netlify, or Render)
# Multiple origins can be comma-separated
FRONTEND_URL=https://smartbillmanager.vercel.app

# =======================================================
# Mail Configuration (Gmail SMTP)
# =======================================================
MAIL_USERNAME=smartadmin4@gmail.com
MAIL_APP_PASSWORD=your_16_char_google_app_password
